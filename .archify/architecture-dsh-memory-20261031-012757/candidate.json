  "cards": [
    {
      "dot": "cyan",
      "title": "事实只有一份",
      "items": [
        "事件追加后不可就地改写；surface 是从日志折叠出来的当前历史",
        "replace 遮蔽一段区间，旧事件仍在日志里，回放可以还原",
        "模型可见必须能由日志重建，但审计事件不进模型历史"
      ]
    },
    {
      "dot": "emerald",
      "title": "没有滑动窗口",
      "items": [
        "deriveMessages() 遍历当前 surface 的全部节点，没有最近 N 轮或 offset/limit",
        "上下文变小只来自显式 replace、内容投影或有界输入",
        "provider 仍可能先报超窗，再由 overflow 恢复路径处理"
      ]
    },
    {
      "dot": "amber",
      "title": "四个阀门，触发点不同",
      "items": [
        "溢出：工具结果估算超过 12500 token 时尝试外置；保存失败会保留原内容",
        "剪裁：只在压缩已被调用后运行，按字符预算替换",
        "图片卸载：provider 报错后换占位并重发一次请求",
        "压缩：压力阈值、溢出或手动触发；它会发起独立的摘要调用"
      ]
    },
    {
      "dot": "violet",
      "title": "相邻机制不是记忆",
      "items": [
        "技能目录只有名称和描述；正文通过 skill 工具结果或显式 invocation 注入",
        "AGENTS.md 是有字节预算的 user message，不是隐式系统提示",
        "运行时上下文是快照；会话引用是只读有界快照",
        "子 Agent 有自己的 Session，不与父会话共享 surface"
      ]
    },
    {
      "dot": "slate",
      "title": "占用是估算",
      "items": [
        "token meter 优先用 provider usage 锚点，否则按字符密度估算",
        "百分比是压力趋势，不是精确余量"
      ]
    }
  ]
}
