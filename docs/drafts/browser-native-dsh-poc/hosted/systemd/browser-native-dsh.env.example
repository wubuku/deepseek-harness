# /etc/browser-native-dsh/browser-native-dsh.env
#
# Values below match hosted-deployment.md; adjust paths and limits per host.
# The file must be readable by the service user only (0640 root:dsh).

DSH_POC_HOST=127.0.0.1
DSH_POC_PORT=4185
DSH_POC_DATA_DIR=/var/lib/browser-native-dsh
DSH_POC_DIST_ROOT=/opt/browser-native-dsh/apps/web/dist
DSH_POC_BUILD=0
DSH_POC_LLM=scripted

# Set when a TLS reverse proxy terminates the public origin (same value here and
# in the proxy's server name); the backend then admits that Host and Origin and
# marks its auth cookie Secure.
# DSH_POC_PUBLIC_ORIGIN=https://dsh.example.com

# Real provider mode: keep credentials in this file only.
# DSH_POC_LLM=real
# DSH_POC_ENV_FILE=/etc/browser-native-dsh/provider.env
