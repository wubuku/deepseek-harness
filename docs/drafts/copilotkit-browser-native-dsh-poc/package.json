{
  "name": "dsh-copilotkit-browser-native-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "build:overlay": "node profile-overlay/build-overlay.mjs",
    "build": "npm run build:overlay && vite build",
    "dev": "vite",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node tests/copilotkit-browser-native.e2e.mjs",
    "test:e2e:real": "node tests/copilotkit-browser-native.e2e.mjs --llm real",
    "test:e2e:chrome:real": "node tests/copilotkit-browser-native.e2e.mjs --browser chrome --llm real",
    "test:e2e:restart": "node tests/session-restart.e2e.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@copilotkit/react-core": "1.79.1",
    "@copilotkit/react-ui": "1.79.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rxjs": "7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  }
}
